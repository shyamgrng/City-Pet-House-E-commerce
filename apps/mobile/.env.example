# Copy this file to .env.local (gitignored) to pull live admin-edited page content (hero
# banner, services, blog, FAQ, career jobs, legal pages, pet tag / microchip lookups, ...) from
# the same Supabase project the website uses -- otherwise the app falls back to its own
# built-in sample content and admin edits made on the website won't show up here.
#
# Use the exact same values as apps/web's NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# (Supabase dashboard > Project Settings > API), no new project needed.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

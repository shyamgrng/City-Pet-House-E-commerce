# Brevo (transactional email) — required for client notification emails to send.
# Get an API key from https://app.brevo.com/settings/keys/api
# Copy this file to .env.local (gitignored) and fill in real values.
# IMPORTANT: BREVO_SENDER_EMAIL must be a *verified* sender in your Brevo account
# (Brevo dashboard > Settings > Senders & IP) -- Brevo rejects every send from an
# unverified address, which is the most common reason emails silently fail to go out.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@citypethouse.com.np
BREVO_SENDER_NAME=City Pet House & Animal Clinic

# Supabase — required for Web Vet bookings/chat/files and for orders/refunds to sync between
# devices (e.g. a customer's phone and the admin dashboard). Without these, both still work but
# only on the one browser that created the booking/order.
# Create a free project at https://supabase.com, run supabase/vet-schema.sql AND
# supabase/orders-schema.sql in its SQL Editor, then copy the Project URL and "anon public" key
# from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Daily.co (video calling) — required for the Web Vet video call to actually work.
# Create a free account at https://dashboard.daily.co/signup, then copy the API key from
# https://dashboard.daily.co/developers. Keep this one secret (no NEXT_PUBLIC_ prefix) --
# it's only ever used on the server to create call rooms.
DAILY_API_KEY=

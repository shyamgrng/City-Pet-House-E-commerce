# Brevo (transactional email) — required for client notification emails to send.
# Get an API key from https://app.brevo.com/settings/keys/api
# Copy this file to .env.local (gitignored) and fill in real values.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=citypethouse@gmail.com
BREVO_SENDER_NAME=City Pet House & Animal Clinic

# Supabase — required for Web Vet bookings/chat/files to sync between the doctor's and the
# client's devices. Without these, Web Vet still works but only on one browser at a time.
# Create a free project at https://supabase.com, run supabase/vet-schema.sql in its SQL Editor,
# then copy the Project URL and "anon public" key from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

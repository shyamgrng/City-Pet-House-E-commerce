// City Pet House — full data model (see docs/ARCHITECTURE_PROPOSAL.md §2).
// Phase 1 (website) actively uses: User/roles, PetOwnerProfile, Address,
// Product, PetListing, AdoptionPost, Cart/CartItem, Wishlist, Order/OrderItem/
// OrderChecklistItem/OrderStatusEvent/Refund. The rest of the model
// (vet consult, doctor/B2B/courier profiles, registries, CMS, finance,
// notifications) is defined now so later phases don't require destructive
// migrations, but has no service layer yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

enum UserRole {
  PET_OWNER
  DOCTOR
  B2B_SUPPLIER
  COURIER
  ADMIN_STAFF
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  petOwnerProfile PetOwnerProfile?
  doctorProfile   DoctorProfile?
  b2bProfile      B2BSupplierProfile?
  courierProfile  CourierProfile?
  adminProfile    AdminStaffProfile?

  refreshTokens RefreshToken[]
  notifications Notification[]

  @@index([role])
}

// Refresh tokens are per-surface sessions (README: "only the login session
// is per-device") — audience distinguishes web/mobile/staff-app sessions for
// the same user without letting one surface's token authenticate another.
model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  audience    String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model PetOwnerProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  addresses Address[]
  pets      Pet[]
  carts     Cart[]
  wishlist  WishlistItem[]
  orders    Order[]
  vetBookings VetBooking[]
  adoptionPosts AdoptionPost[]
}

model Address {
  id            String          @id @default(cuid())
  ownerId       String
  owner         PetOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label         String
  address       String
  phone         String
  altPhone      String?
  mapLink       String?
  isPrimary     Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([ownerId])
}

model DoctorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  qualification   String?
  licenseNo       String?
  address         String?
  emergencyContact String?
  bankName        String?
  bankHolder      String?
  bankAccount     String?
  consultFee      Int      @default(0)
  commissionType  String   @default("percent")
  commissionValue Int      @default(0)
  isOnline        Boolean  @default(false)
  verified        Boolean  @default(false)
  registrationDocs String[]

  bookings VetBooking[]
  payoutSlips DoctorPayoutSlip[]
}

model B2BSupplierProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  contactName     String
  phone           String?
  altPhone        String?
  address         String?
  categories      String[]
  commissionPct   Int      @default(15)
  verified        Boolean  @default(false)
  registrationDocs String[]

  products     Product[]
  financeEntries B2BFinanceLedgerEntry[]
}

model CourierProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  contactName     String
  phone           String?
  altPhone        String?
  address         String?
  verified        Boolean  @default(false)
  registrationDocs String[]

  assignments CourierAssignment[]
}

model AdminStaffProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  role   String // Admin | Manager | Staff (extensible; see RolePermission)

  permissions RolePermission[]
}

model RolePermission {
  id        String            @id @default(cuid())
  staffId   String
  staff     AdminStaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  section   String // dashboard | deliveries | vetconsults | shop | finance | users
  granted   Boolean           @default(false)

  @@unique([staffId, section])
}

// ---------- Pets (first-class entity — see ARCHITECTURE_PROPOSAL §2 open question) ----------

model Pet {
  id        String          @id @default(cuid())
  ownerId   String
  owner     PetOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  species   String
  breed     String?
  createdAt DateTime        @default(now())

  vetBookings VetBooking[]
  petTag      PetTag?

  @@index([ownerId])
}

// ---------- Catalog ----------

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  category      String
  brand         String?
  sku           String?  @unique
  price         Int
  costPrice     Int?
  qty           Int      @default(0)
  lowStockThreshold Int  @default(5)
  images        String[]
  tags          String[]
  rating        Float?
  outOfStock    Boolean  @default(false)
  status        String   @default("ACTIVE")
  supplierId    String?
  supplier      B2BSupplierProfile? @relation(fields: [supplierId], references: [id])
  commissionPct Int?
  todaysDeal    Boolean  @default(false)
  dealStart     DateTime?
  dealEnd       DateTime?
  badge         String?
  homeCategoryPlacement String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlisted  WishlistItem[]

  @@index([category])
  @@index([supplierId])
}

enum PetListingStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model PetListing {
  id           String            @id @default(cuid())
  breed        String
  species      String
  sex          String
  age          String
  price        Int
  deliveryFee  Int               @default(0)
  images       String[]
  videos       String[]
  tags         String[]
  rating       Float?
  status       PetListingStatus  @default(AVAILABLE)
  createdAt    DateTime          @default(now())

  @@index([species])
}

model AdoptionPost {
  id                String          @id @default(cuid())
  postedById        String
  postedBy          PetOwnerProfile @relation(fields: [postedById], references: [id])
  name              String
  breed             String
  age               String
  sex               String
  vaccinationStatus String?
  address           String
  description       String
  contact           String
  photos            String[]
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())

  @@index([postedById])
}

// ---------- Cart / Wishlist ----------

model Cart {
  id        String          @id @default(cuid())
  ownerId   String?         @unique // one cart per signed-in owner
  owner     PetOwnerProfile? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deviceKey String?         @unique // anonymous cart before sign-in; merged into owner's cart on login
  items     CartItem[]
  updatedAt DateTime        @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int

  @@unique([cartId, productId])
}

model WishlistItem {
  id        String          @id @default(cuid())
  ownerId   String
  owner     PetOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([ownerId, productId])
}

// ---------- Orders (the sync backbone) ----------

enum OrderStage {
  PAYMENT_QUEUE
  CONFIRMED
  DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Order {
  id                 String          @id // e.g. ORD-100234, assigned by OrderIdSequence — never a client-supplied value
  buyerId            String
  buyer              PetOwnerProfile @relation(fields: [buyerId], references: [id])
  addressSnapshot     Json
  amount             Int
  deliveryFee        Int             @default(0)
  paymentMethod      String
  paymentReceiptUrl  String
  paymentStatus      PaymentStatus   @default(PENDING_REVIEW)
  stage              OrderStage      @default(PAYMENT_QUEUE)
  courierId          String?
  courierAssignment  CourierAssignment?
  cancellationReason String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items         OrderItem[]
  checklist     OrderChecklistItem[]
  statusHistory OrderStatusEvent[]

  @@index([buyerId])
  @@index([stage])
}

// Guarantees globally-unique, gap-free order IDs — the prototype's known bug
// (README: "Order IDs must be globally unique — never reuse") — via a single
// DB row updated inside the same transaction that creates the order.
model OrderIdSequence {
  id     Int @id @default(1)
  nextVal Int @default(1000)
}

model VetBookingIdSequence {
  id      Int @id @default(1)
  nextVal Int @default(0)
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  nameSnapshot    String
  priceSnapshot   Int
  qty             Int
  supplierId      String?  // denormalized at order time — supplier-scoping survives later product edits
  outOfStock      Boolean  @default(false)
  refundRequested Boolean  @default(false)
  sentToCph       Boolean  @default(false)

  refund Refund?

  @@index([orderId])
  @@index([supplierId])
}

model OrderChecklistItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String
  checked   Boolean  @default(false)
  checkedAt DateTime?
  checkedBy String?

  @@index([orderId])
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage     String
  actor     String?
  note      String?
  at        DateTime @default(now())

  @@index([orderId])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PAID
}

model Refund {
  id          String       @id @default(cuid())
  orderItemId String       @unique
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  requestedBy String
  reason      String
  amount      Int
  status      RefundStatus @default(REQUESTED)
  createdAt   DateTime     @default(now())
}

model CourierAssignment {
  id                 String    @id @default(cuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierId          String
  courier            CourierProfile @relation(fields: [courierId], references: [id])
  assignedAt         DateTime  @default(now())
  receivedAt         DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
}

// ---------- Vet consult ----------

enum VetBookingStatus {
  PENDING_PAYMENT
  PAYMENT_APPROVED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model VetBooking {
  id                  String            @id @default(cuid())
  ownerId             String
  owner               PetOwnerProfile   @relation(fields: [ownerId], references: [id])
  petId               String?
  pet                 Pet?              @relation(fields: [petId], references: [id])
  doctorId            String
  doctor              DoctorProfile     @relation(fields: [doctorId], references: [id])
  isOnline            Boolean           @default(true)
  scheduledAt         DateTime
  reason              String
  amount              Int
  paymentReceiptUrl   String?
  paymentApprovedAt   DateTime?
  doctorReconfirmedAt DateTime?
  status              VetBookingStatus  @default(PENDING_PAYMENT)
  roomChannel         String            @unique
  callStartedAt       DateTime?
  callEndedAt         DateTime?
  callDurationSec     Int?
  invoiceNumber       String?
  createdAt           DateTime          @default(now())

  chatMessages VetChatMessage[]
  documents    VetDocument[]
  notes        VetConsultNote[]

  @@index([ownerId])
  @@index([doctorId])
}

model VetChatMessage {
  id        String     @id @default(cuid())
  bookingId String
  booking   VetBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  from      String // "client" | "doctor"
  text      String?
  attachmentUrl String?
  sentAt    DateTime   @default(now())

  @@index([bookingId])
}

model VetDocument {
  id         String     @id @default(cuid())
  bookingId  String
  booking    VetBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedBy String
  fileUrl    String
  name       String
  uploadedAt DateTime   @default(now())
}

model VetConsultNote {
  id        String     @id @default(cuid())
  bookingId String
  booking   VetBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  doctorId  String
  text      String
  createdAt DateTime   @default(now())
}

model WebVetSetting {
  id     Int     @id @default(1)
  active Boolean @default(true)
}

model DoctorPayoutSlip {
  id         String        @id @default(cuid())
  doctorId   String
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id])
  bookingIds String[]
  amount     Int
  slipNumber String        @unique
  paidAt     DateTime      @default(now())
}

model B2BFinanceLedgerEntry {
  id            String              @id @default(cuid())
  supplierId    String
  supplier      B2BSupplierProfile  @relation(fields: [supplierId], references: [id])
  orderItemId   String              @unique
  saleAmount    Int
  commissionPct Int
  payableAmount Int
  paidStatus    String              @default("UNPAID")
  paidAt        DateTime?
  receiptUrl    String?
  createdAt     DateTime            @default(now())
}

// ---------- Registries ----------

model PetTag {
  id          String   @id @default(cuid())
  tagId       String   @unique
  petId       String?  @unique
  pet         Pet?     @relation(fields: [petId], references: [id])
  petName     String
  sex         String?
  age         String?
  breed       String?
  color       String?
  ownerName   String
  phone       String
  altPhone    String?
  address     String?
  mapLink     String?
  microchip   String?
  notes       String?
  photo       String?
  scanCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

model MicrochipRecord {
  id           String   @id @default(cuid())
  mcNumber     String   @unique
  petName      String
  sex          String?
  age          String?
  breed        String?
  color        String?
  ownerName    String
  phone        String
  altPhone     String?
  wardNo       String?
  municipality String?
  houseNo      String?
  district     String?
  provinceNo   String?
  zone         String?
  mapLink      String?
  notes        String?
  vetName      String?
  clinic       String?
  mcDate       DateTime?
  photo        String?
  createdAt    DateTime @default(now())
}

// ---------- CMS ----------

model PageContent {
  key       String   @id // e.g. "home", "about", "terms", "faq", "dog-breed-archive"
  body      Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Testimonial {
  id      String @id @default(cuid())
  author  String
  quote   String
  rating  Float?
}

model Brand {
  id   String @id @default(cuid())
  name String @unique
  logo String?
}

model Service {
  id          String   @id @default(cuid())
  name        String
  shortDesc   String
  seoTitle    String
  longDesc    String
  benefits    String[]
  duration    String?
  price       String?
  schedule    Json?
  photo       String?
  status      String   @default("ACTIVE")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FaqEntry {
  id       String @id @default(cuid())
  category String
  question String
  answer   String
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  author    String?
  isDoctorPost Boolean @default(false)
  photo     String?
  status    String   @default("ACTIVE")
  publishedAt DateTime @default(now())
}

// ---------- Notifications ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  linkRef   String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
